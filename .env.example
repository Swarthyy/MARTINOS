# Create a Supabase project, run supabase/schema.sql, then set both values.
# These are public client configuration values. Never put service_role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only this verified Supabase user can access personal data in the application.
MARTIN_OS_ALLOWED_EMAIL=

# Read-only ChatGPT bank action (server-side values; never prefix with NEXT_PUBLIC_).
# Set these only in the deployment host's secret settings. Do not commit their values.
UP_API_TOKEN=
MARTIN_OS_ACTION_KEY=
